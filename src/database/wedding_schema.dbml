// ============================================================
// WEDDING INVITATION ONLINE - DATABASE SCHEMA (DBML)
// Version: 2.0 — Production Ready
// Database: PostgreSQL 15+
// Updated: 2025
// ============================================================

// ============================================================
// I. AUTH & USER MANAGEMENT
// ============================================================

Table users {
  id              uuid          [pk, default: `gen_random_uuid()`]
  email           varchar(255)  [unique, not null, note: 'Enforce format via CHECK constraint']
  password_hash   varchar(255)  [not null, note: 'bcrypt / argon2id — never plaintext']
  full_name       varchar(100)  [not null]
  phone           varchar(20)   [note: 'E.164 format: +84901234567']
  avatar_url      text
  role            user_role     [not null, default: 'couple']
  is_active       boolean       [not null, default: true]
  email_verified  boolean       [not null, default: false]
  email_verified_at timestamptz
  last_login_at   timestamptz
  deleted_at      timestamptz   [note: 'Soft delete — NULL = active']
  created_at      timestamptz   [not null, default: `now()`]
  updated_at      timestamptz   [not null, default: `now()`]

  indexes {
    email [unique]
    (is_active, deleted_at)
  }

  Note: 'Tài khoản người dùng. Soft delete — không xóa thật khi có subscription/payment history.'
}

Table refresh_tokens {
  id          uuid          [pk, default: `gen_random_uuid()`]
  user_id     uuid          [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  token_hash  varchar(255)  [not null, unique, note: 'SHA-256 của raw token']
  device_info varchar(255)  [note: 'Browser / OS / IP ghi lại lúc đăng nhập']
  expires_at  timestamptz   [not null]
  revoked_at  timestamptz   [note: 'NULL = còn hiệu lực']
  created_at  timestamptz   [not null, default: `now()`]

  indexes {
    token_hash [unique]
    (user_id, revoked_at)
    expires_at
  }

  Note: 'JWT refresh tokens. Revoke khi: đổi mật khẩu, logout, hoặc phát hiện bất thường.'
}


// ============================================================
// II. TEMPLATE SYSTEM
// ============================================================

Table template_categories {
  id          uuid          [pk, default: `gen_random_uuid()`]
  name        varchar(100)  [not null, unique, note: 'Cổ điển, Hiện đại, Tối giản, Mùa hè...']
  slug        varchar(100)  [not null, unique]
  description varchar(255)
  sort_order  integer       [not null, default: 0]
  created_at  timestamptz   [not null, default: `now()`]

  Note: 'Danh mục mẫu thiệp — normalize thay vì varchar trong templates.'
}

Table templates {
  id              uuid          [pk, default: `gen_random_uuid()`]
  category_id     uuid          [ref: > template_categories.id, note: 'ON DELETE SET NULL']
  name            varchar(100)  [not null]
  slug            varchar(100)  [not null, unique]
  thumbnail_url   text
  preview_url     text
  css_config      jsonb         [not null, default: '{}', note: 'Màu, font, spacing — xem docs/template-config.md']
  is_premium      boolean       [not null, default: false]
  is_active       boolean       [not null, default: true]
  sort_order      integer       [not null, default: 0]
  used_count      integer       [not null, default: 0, note: 'Đếm số lần chọn — dùng cho "Phổ biến nhất"']
  deleted_at      timestamptz   [note: 'Soft delete']
  created_at      timestamptz   [not null, default: `now()`]
  updated_at      timestamptz   [not null, default: `now()`]

  indexes {
    slug [unique]
    category_id
    (is_active, is_premium, deleted_at)
    (sort_order, used_count)
  }

  Note: 'Mẫu thiệp cưới — quản lý bởi admin. css_config là nguồn sự thật về giao diện.'
}


// ============================================================
// III. WEDDING CORE
// ============================================================

Table weddings {
  id              uuid            [pk, default: `gen_random_uuid()`]
  user_id         uuid            [not null, ref: > users.id, note: 'ON DELETE RESTRICT — không xóa user khi còn wedding']
  template_id     uuid            [ref: > templates.id, note: 'ON DELETE SET NULL']
  slug            varchar(100)    [unique, not null, note: 'URL công khai /thiep/{slug} — chỉ a-z0-9 và dấu gạch ngang']

  // Thông tin cô dâu
  bride_name          varchar(100)  [not null]
  bride_dob           date
  bride_father_name   varchar(100)
  bride_mother_name   varchar(100)
  bride_photo_url     text

  // Thông tin chú rể
  groom_name          varchar(100)  [not null]
  groom_dob           date
  groom_father_name   varchar(100)
  groom_mother_name   varchar(100)
  groom_photo_url     text

  // Nội dung thiệp
  invitation_text     text          [note: 'Lời mời — viết tay hoặc AI sinh']
  love_story          text          [note: 'Câu chuyện tình yêu — hiển thị dạng timeline']
  hashtag             varchar(100)  [note: 'VD: #AnhVaEmMaiMai']
  dress_code          varchar(100)

  // Nhạc nền
  music_url           text
  music_type          music_type
  music_autoplay      boolean       [not null, default: false]

  // Mừng cưới / Thanh toán
  // SECURITY: bank fields nên encrypt at rest bằng pgcrypto hoặc app-level encryption
  bank_account_number varchar(50)   [note: '[ENCRYPT] Số tài khoản ngân hàng — PII nhạy cảm']
  bank_name           varchar(100)
  bank_account_name   varchar(150)
  bank_transfer_note  varchar(255)
  vietqr_url          text          [note: 'URL QR tự sinh — có thể null nếu chưa gen']

  // Trạng thái & vòng đời
  status              wedding_status  [not null, default: 'draft']
  published_at        timestamptz
  expires_at          timestamptz     [note: 'Hết hạn theo gói dịch vụ']
  deleted_at          timestamptz     [note: 'Soft delete']
  created_at          timestamptz     [not null, default: `now()`]
  updated_at          timestamptz     [not null, default: `now()`]

  indexes {
    slug [unique]
    user_id
    (status, deleted_at)
    (user_id, status, deleted_at)
    expires_at
  }

  Note: '''
    Bảng trung tâm hệ thống. Thông tin sự kiện (lễ ăn hỏi, lễ cưới, tiệc)
    đã được tách ra bảng wedding_events để dễ mở rộng.
  '''
}

Table wedding_events {
  id              uuid          [pk, default: `gen_random_uuid()`]
  wedding_id      uuid          [not null, ref: > weddings.id, note: 'ON DELETE CASCADE']
  event_type      event_type    [not null, note: 'engagement | ceremony | reception | custom']
  name            varchar(100)  [note: 'Tên tùy chỉnh — dùng khi event_type = custom']
  starts_at       timestamptz   [not null]
  ends_at         timestamptz
  venue_name      varchar(255)
  venue_address   text
  maps_url        text          [note: 'Google Maps / Apple Maps share link']
  lat             decimal(10,7)
  lng             decimal(10,7)
  note            text          [note: 'Ghi chú thêm: dress code, parking, ...']
  sort_order      integer       [not null, default: 0]
  created_at      timestamptz   [not null, default: `now()`]
  updated_at      timestamptz   [not null, default: `now()`]

  indexes {
    wedding_id
    (wedding_id, event_type)
    (wedding_id, sort_order)
  }

  Note: '''
    Thay thế 12 flat columns engagement_*/ceremony_*/reception_* trong v1.
    Mỗi đám cưới có thể có N sự kiện.
    Sort_order quyết định thứ tự hiển thị trên thiệp.
  '''
}

Table wedding_photos {
  id            uuid          [pk, default: `gen_random_uuid()`]
  wedding_id    uuid          [not null, ref: > weddings.id, note: 'ON DELETE CASCADE']
  url           text          [not null]
  storage_key   varchar(500)  [not null, note: 'Key trên S3/Cloudinary — dùng để xóa file khi cần']
  caption       varchar(255)
  is_cover      boolean       [not null, default: false, note: 'Ảnh bìa chính của thiệp']
  sort_order    integer       [not null, default: 0]
  deleted_at    timestamptz
  created_at    timestamptz   [not null, default: `now()`]

  indexes {
    wedding_id
    (wedding_id, is_cover)
    (wedding_id, deleted_at, sort_order)
  }

  Note: 'Album ảnh cưới — cặp đôi upload từ Admin Portal. is_cover chỉ được 1 ảnh/wedding.'
}


// ============================================================
// IV. GUEST MANAGEMENT
// ============================================================

Table guest_groups {
  id            uuid          [pk, default: `gen_random_uuid()`]
  wedding_id    uuid          [not null, ref: > weddings.id, note: 'ON DELETE CASCADE']
  name          varchar(100)  [not null, note: 'Họ hàng, Bạn thân, Đồng nghiệp...']
  color_label   varchar(7)    [note: 'Mã màu HEX, VD: #FF5733']
  description   varchar(255)
  sort_order    integer       [not null, default: 0]
  created_at    timestamptz   [not null, default: `now()`]

  indexes {
    (wedding_id, name)
  }

  Note: 'Nhóm phân loại khách mời — do cặp đôi tự định nghĩa.'
}

Table guests {
  id                    uuid          [pk, default: `gen_random_uuid()`]
  wedding_id            uuid          [not null, ref: > weddings.id, note: 'ON DELETE CASCADE']
  group_id              uuid          [ref: > guest_groups.id, note: 'ON DELETE SET NULL']
  table_id              uuid          [ref: > seating_tables.id, note: 'ON DELETE SET NULL — NULL = chưa xếp bàn']

  // Thông tin cơ bản — PII, cần data retention policy
  full_name             varchar(100)  [not null]
  salutation            varchar(20)   [note: 'Anh, Chị, Bác, Cô, Chú...']
  phone                 varchar(20)   [note: '[PII] E.164 format']
  email                 varchar(255)  [note: '[PII] Dùng để gửi thiệp qua email']

  // Phân loại
  side                  guest_side    [not null, default: 'both']
  is_vip                boolean       [not null, default: false]

  // Mã mời cá nhân hóa
  invitation_code       varchar(32)   [unique, not null, note: 'Sinh ngẫu nhiên — URL-safe']
  qr_code_url           text          [note: 'URL ảnh QR cá nhân — gen lúc tạo hoặc lazy']

  // RSVP
  rsvp_status           rsvp_status   [not null, default: 'pending']
  attending_count       smallint      [not null, default: 1, note: 'Tổng người đi kèm — CHECK >= 0 AND <= 20']
  dietary               dietary_pref  [not null, default: 'normal']
  dietary_note          varchar(255)
  needs_transport       boolean       [not null, default: false]
  rsvp_note             text
  rsvp_at               timestamptz

  // Tracking gửi thiệp
  invited_at            timestamptz
  invitation_viewed_at  timestamptz
  invitation_view_count integer       [not null, default: 0]

  // Soft delete
  deleted_at            timestamptz
  created_at            timestamptz   [not null, default: `now()`]
  updated_at            timestamptz   [not null, default: `now()`]

  indexes {
    invitation_code [unique]
    (wedding_id, deleted_at)
    (wedding_id, rsvp_status, deleted_at)
    (wedding_id, group_id)
    (wedding_id, table_id)
    (wedding_id, side)
  }

  Note: '''
    [PII] phone và email cần data retention policy.
    Xem xét anonymize sau N ngày khi wedding status = archived.
    invitation_code là key truy cập thiệp cá nhân hóa — phải unique toàn hệ thống.
  '''
}


// ============================================================
// V. SEATING PLANNER
// ============================================================

Table seating_tables {
  id              uuid          [pk, default: `gen_random_uuid()`]
  wedding_id      uuid          [not null, ref: > weddings.id, note: 'ON DELETE CASCADE']
  name            varchar(50)   [not null, note: 'Bàn 1, Bàn VIP, Bàn Gia đình...']
  max_seats       smallint      [not null, default: 10, note: 'CHECK > 0 AND <= 100']
  description     varchar(255)
  position_x      integer       [note: 'Tọa độ X trên canvas sơ đồ bàn (px)']
  position_y      integer       [note: 'Tọa độ Y trên canvas sơ đồ bàn (px)']
  created_at      timestamptz   [not null, default: `now()`]
  updated_at      timestamptz   [not null, default: `now()`]

  indexes {
    wedding_id
  }

  Note: '''
    Đổi tên từ "tables" → "seating_tables" tránh conflict với reserved keyword SQL.
    current_seats đã bỏ — tính động bằng COUNT(guests WHERE table_id = id AND deleted_at IS NULL).
  '''
}


// ============================================================
// VI. GUEST INTERACTIONS
// ============================================================

Table wishes {
  id            uuid          [pk, default: `gen_random_uuid()`]
  wedding_id    uuid          [not null, ref: > weddings.id, note: 'ON DELETE CASCADE']
  guest_id      uuid          [ref: > guests.id, note: 'ON DELETE SET NULL — giữ lời chúc dù xóa guest']
  guest_name    varchar(100)  [not null, note: 'Fallback khi guest_id null (khách ẩn danh)']
  content       text          [not null]
  is_approved   boolean       [not null, default: true, note: 'false = chờ kiểm duyệt']
  is_pinned     boolean       [not null, default: false]
  approved_at   timestamptz
  approved_by   uuid          [ref: > users.id, note: 'ON DELETE SET NULL — admin duyệt']
  created_at    timestamptz   [not null, default: `now()`]

  indexes {
    (wedding_id, is_approved, is_pinned)
    (wedding_id, created_at)
    guest_id
  }

  Note: 'Lời chúc trên thiệp. is_pinned = ghim lên đầu. Giữ lại dù xóa guest.'
}

Table photo_wall {
  id              uuid          [pk, default: `gen_random_uuid()`]
  wedding_id      uuid          [not null, ref: > weddings.id, note: 'ON DELETE CASCADE']
  guest_id        uuid          [ref: > guests.id, note: 'ON DELETE SET NULL']
  uploader_name   varchar(100)  [not null]
  url             text          [not null]
  storage_key     varchar(500)  [not null]
  caption         varchar(255)
  is_approved     boolean       [not null, default: true]
  approved_at     timestamptz
  approved_by     uuid          [ref: > users.id, note: 'ON DELETE SET NULL']
  deleted_at      timestamptz
  created_at      timestamptz   [not null, default: `now()`]

  indexes {
    (wedding_id, is_approved, deleted_at)
    guest_id
  }

  Note: 'Ảnh do khách upload tại tiệc — Wedding Photo Wall.'
}


// ============================================================
// VII. NOTIFICATIONS & AUTOMATION
// ============================================================

Table notification_templates {
  id            uuid          [pk, default: `gen_random_uuid()`]
  name          varchar(100)  [not null]
  channel       notif_channel [not null]
  type          notif_type    [not null]
  subject       varchar(255)  [note: 'Chủ đề email — null cho Zalo/SMS']
  body_template text          [not null, note: 'Handlebars/Mustache template với {{variables}}']
  variables     jsonb         [not null, default: '[]', note: 'Danh sách biến được dùng trong template']
  is_active     boolean       [not null, default: true]
  created_at    timestamptz   [not null, default: `now()`]
  updated_at    timestamptz   [not null, default: `now()`]

  indexes {
    (channel, type, is_active)
  }

  Note: 'Template thông báo tái sử dụng — tách nội dung khỏi bảng notifications để dễ quản lý.'
}

Table notifications {
  id                uuid          [pk, default: `gen_random_uuid()`]
  wedding_id        uuid          [not null, ref: > weddings.id, note: 'ON DELETE CASCADE']
  guest_id          uuid          [ref: > guests.id, note: 'ON DELETE SET NULL — NULL = broadcast']
  template_id       uuid          [ref: > notification_templates.id, note: 'ON DELETE RESTRICT']

  // Nội dung đã render (lưu snapshot để audit)
  channel           notif_channel [not null]
  type              notif_type    [not null]
  subject           varchar(255)
  content           text          [not null, note: 'Nội dung đã render — snapshot tại thời điểm gửi']
  recipient         varchar(255)  [not null, note: 'Địa chỉ đích: email / phone / zalo_id']

  // Trạng thái gửi
  status            notif_status  [not null, default: 'pending']
  scheduled_at      timestamptz   [not null]
  sent_at           timestamptz
  failed_reason     text
  retry_count       smallint      [not null, default: 0]
  max_retries       smallint      [not null, default: 3]

  // Provider tracking
  provider          varchar(50)   [note: 'Zalo ZNS, Twilio, SendGrid, SMTP...']
  provider_msg_id   varchar(255)  [note: 'Message ID từ provider — dùng để check delivery']

  created_at        timestamptz   [not null, default: `now()`]

  indexes {
    (status, scheduled_at)   [note: 'Partial index: WHERE status = pending — xem migration']
    (wedding_id, type, status)
    guest_id
    provider_msg_id
  }

  Note: '''
    Cron job query: WHERE status = 'pending' AND scheduled_at <= now()
    → Dùng partial index: CREATE INDEX ON notifications(scheduled_at) WHERE status = 'pending'
    retry_count và max_retries phục vụ exponential backoff khi gửi thất bại.
  '''
}


// ============================================================
// VIII. AI ASSISTANT
// ============================================================

Table ai_suggestions {
  id              uuid          [pk, default: `gen_random_uuid()`]
  wedding_id      uuid          [not null, ref: > weddings.id, note: 'ON DELETE CASCADE']

  // Input parameters
  target_group    ai_target     [not null]
  tone            ai_tone       [not null]
  language        varchar(5)    [not null, default: 'vi']
  custom_prompt   text
  context_data    jsonb         [note: 'Snapshot thông tin đám cưới lúc gen — bride/groom name, date...']

  // Output
  generated_text  text          [not null]
  model_used      varchar(50)   [not null, note: 'claude-sonnet-4, gpt-4o, gemini-pro...']
  prompt_tokens   integer
  completion_tokens integer
  total_tokens    integer

  // Usage tracking
  is_used         boolean       [not null, default: false]
  used_at         timestamptz
  feedback        smallint      [note: '1 = tích cực / -1 = tiêu cực / NULL = chưa feedback']

  created_at      timestamptz   [not null, default: `now()`]

  indexes {
    (wedding_id, is_used)
    (model_used, created_at)  [note: 'Dùng để tổng hợp chi phí token theo model']
  }

  Note: 'Lịch sử sinh lời mời bằng AI. context_data lưu snapshot để audit nếu cần.'
}


// ============================================================
// IX. GIFT REGISTRY
// ============================================================

Table gift_registry {
  id              uuid          [pk, default: `gen_random_uuid()`]
  wedding_id      uuid          [not null, ref: > weddings.id, note: 'ON DELETE CASCADE']
  name            varchar(255)  [not null, note: 'Tên món quà / mong muốn']
  description     text
  image_url       text
  external_url    text          [note: 'Link sản phẩm trên Shopee/Tiki/Lazada...']
  price_vnd       bigint
  is_purchased    boolean       [not null, default: false]
  purchased_by    varchar(100)  [note: 'Tên khách mua — không bắt buộc']
  purchased_at    timestamptz
  sort_order      integer       [not null, default: 0]
  created_at      timestamptz   [not null, default: `now()`]
  updated_at      timestamptz   [not null, default: `now()`]

  indexes {
    (wedding_id, is_purchased)
  }

  Note: 'Danh sách quà cưới mong muốn — khách xem và đánh dấu đã mua.'
}


// ============================================================
// X. SERVICE PLANS & SUBSCRIPTIONS
// ============================================================

Table service_plans {
  id                    uuid          [pk, default: `gen_random_uuid()`]
  name                  varchar(50)   [not null, unique, note: 'Free | Basic | Premium | VIP']
  slug                  varchar(50)   [not null, unique]
  description           text
  max_guests            integer       [not null, note: 'CHECK >= 0 — 0 = unlimited']
  max_photos            integer       [not null, note: 'CHECK >= 0']
  max_ai_uses           integer       [not null, default: 0]
  has_custom_slug       boolean       [not null, default: false]
  has_analytics         boolean       [not null, default: false]
  has_photo_wall        boolean       [not null, default: false]
  has_gift_registry     boolean       [not null, default: false]
  has_seating_planner   boolean       [not null, default: false]
  has_zalo_notification boolean       [not null, default: false]
  has_sms_notification  boolean       [not null, default: false]
  duration_days         integer       [not null, note: 'CHECK > 0 — 30 | 90 | 180 | 365']
  price_vnd             bigint        [not null, note: 'CHECK >= 0 — 0 = free']
  is_active             boolean       [not null, default: true]
  sort_order            integer       [not null, default: 0]
  created_at            timestamptz   [not null, default: `now()`]
  updated_at            timestamptz   [not null, default: `now()`]

  Note: 'Gói dịch vụ — admin quản lý. Không xóa thật để giữ lịch sử subscriptions.'
}

Table subscriptions {
  id                  uuid          [pk, default: `gen_random_uuid()`]
  user_id             uuid          [not null, ref: > users.id, note: 'ON DELETE RESTRICT']
  wedding_id          uuid          [not null, ref: > weddings.id, note: 'ON DELETE RESTRICT']
  plan_id             uuid          [not null, ref: > service_plans.id, note: 'ON DELETE RESTRICT']
  status              sub_status    [not null, default: 'active']
  started_at          timestamptz   [not null, default: `now()`]
  expires_at          timestamptz   [not null, note: 'CHECK > started_at']

  // Payment info
  paid_amount_vnd     bigint        [note: 'Số tiền thực tế thanh toán — có thể khác plan nếu có voucher']
  currency            varchar(3)    [not null, default: 'VND']
  payment_method      varchar(50)   [note: 'momo | vnpay | bank_transfer | zalopay | free']
  payment_ref         varchar(255)  [unique, note: 'Mã giao dịch từ payment gateway — unique']
  payment_metadata    jsonb         [note: 'Raw response từ payment gateway để đối soát']

  // Voucher
  voucher_code        varchar(50)
  discount_amount_vnd bigint        [not null, default: 0]

  created_at          timestamptz   [not null, default: `now()`]
  updated_at          timestamptz   [not null, default: `now()`]

  indexes {
    user_id
    wedding_id
    (status, expires_at)
    payment_ref [unique]
  }

  Note: '''
    ON DELETE RESTRICT trên user_id, wedding_id, plan_id — bảo vệ lịch sử thanh toán.
    Mỗi wedding có thể có nhiều subscription (gia hạn, nâng cấp).
    Sub active = subscription mới nhất có status = active và expires_at > now().
  '''
}


// ============================================================
// XI. ANALYTICS
// ============================================================

Table analytics_events {
  id              uuid          [pk, default: `gen_random_uuid()`]
  wedding_id      uuid          [not null, ref: > weddings.id, note: 'ON DELETE CASCADE']
  guest_id        uuid          [ref: > guests.id, note: 'ON DELETE SET NULL — null = anonymous']
  event_type      analytics_event_type  [not null]
  session_id      varchar(64)   [note: 'Browser session ID — anonymous tracking']
  referrer        text          [note: 'Nguồn traffic: Zalo, Facebook, direct...']
  user_agent      text
  ip_address      inet          [note: '[PII] Dùng để detect bot / duplicate views']
  metadata        jsonb         [not null, default: '{}', note: 'Data bổ sung theo từng event_type']
  created_at      timestamptz   [not null, default: `now()`]

  indexes {
    (wedding_id, event_type, created_at)
    (wedding_id, created_at)
    guest_id
    session_id
  }

  Note: '''
    Bảng append-only — không update, không delete (trừ khi wedding bị xóa).
    Partition by created_at (monthly) khi data lớn.
    Các event_type: page_view | rsvp_submit | wish_submit | photo_upload | qr_scan | share_click
  '''
}


// ============================================================
// XII. AUDIT LOG
// ============================================================

Table action_logs {
  id              uuid          [pk, default: `gen_random_uuid()`]
  actor_id        uuid          [ref: > users.id, note: 'ON DELETE SET NULL']
  actor_role      user_role     [note: 'Snapshot role tại thời điểm action']
  target_table    varchar(100)  [not null]
  target_id       uuid          [not null]
  action          audit_action  [not null, note: 'INSERT | UPDATE | DELETE | PUBLISH | ARCHIVE']
  old_values      jsonb         [note: 'Giá trị trước thay đổi — null với INSERT']
  new_values      jsonb         [note: 'Giá trị sau thay đổi — null với DELETE']
  ip_address      inet
  user_agent      text
  created_at      timestamptz   [not null, default: `now()`]

  indexes {
    (target_table, target_id)
    (actor_id, created_at)
    created_at
  }

  Note: '''
    Append-only — không được UPDATE hoặc DELETE bất kỳ record nào.
    Bắt buộc log: thay đổi weddings, subscriptions, templates, users.
    Implement bằng PostgreSQL trigger hoặc application middleware.
  '''
}


// ============================================================
// ENUMS
// ============================================================

Enum user_role {
  couple  [note: 'Cô dâu / Chú rể']
  admin   [note: 'Quản trị hệ thống']
}

Enum wedding_status {
  draft       [note: 'Đang chỉnh sửa — chỉ owner xem được']
  published   [note: 'Đã xuất bản — khách mời xem được qua slug']
  archived    [note: 'Lưu trữ sau ngày cưới — vẫn có thể xem nhưng không edit']
}

Enum event_type {
  engagement  [note: 'Lễ ăn hỏi']
  ceremony    [note: 'Lễ cưới']
  reception   [note: 'Tiệc cưới']
  custom      [note: 'Sự kiện tùy chỉnh — dùng trường name']
}

Enum music_type {
  upload    [note: 'File MP3 tự upload']
  youtube   [note: 'YouTube embed URL']
  spotify   [note: 'Spotify track URL']
}

Enum guest_side {
  groom   [note: 'Khách nhà trai']
  bride   [note: 'Khách nhà gái']
  both    [note: 'Chung — không phân biệt']
}

Enum rsvp_status {
  pending    [note: 'Chưa phản hồi']
  attending  [note: 'Xác nhận tham dự']
  declined   [note: 'Không tham dự']
}

Enum dietary_pref {
  normal      [note: 'Ăn bình thường']
  vegetarian  [note: 'Ăn chay']
  halal       [note: 'Halal']
  other       [note: 'Yêu cầu khác — xem dietary_note']
}

Enum notif_channel {
  zalo    [note: 'Zalo ZNS']
  sms     [note: 'SMS Gateway (Twilio / ESMS)']
  email   [note: 'Email (SendGrid / SES)']
}

Enum notif_type {
  invite        [note: 'Gửi thiệp mời lần đầu']
  reminder      [note: 'Nhắc lịch trước N ngày']
  rsvp_confirm  [note: 'Xác nhận RSVP cho khách']
  thank_you     [note: 'Cảm ơn sau đám cưới']
}

Enum notif_status {
  pending    [note: 'Chờ gửi']
  sent       [note: 'Đã gửi thành công']
  failed     [note: 'Gửi thất bại — xem failed_reason']
  cancelled  [note: 'Đã hủy']
}

Enum ai_target {
  family    [note: 'Họ hàng']
  friend    [note: 'Bạn bè']
  colleague [note: 'Đồng nghiệp']
  general   [note: 'Chung — không rõ quan hệ']
}

Enum ai_tone {
  formal   [note: 'Trang trọng']
  warm     [note: 'Thân mật']
  fun      [note: 'Vui tươi, trẻ trung']
  poetic   [note: 'Thơ văn, lãng mạn']
}

Enum sub_status {
  active    [note: 'Đang hoạt động']
  expired   [note: 'Hết hạn']
  cancelled [note: 'Đã hủy trước hạn']
}

Enum analytics_event_type {
  page_view     [note: 'Xem thiệp']
  rsvp_submit   [note: 'Gửi RSVP']
  wish_submit   [note: 'Gửi lời chúc']
  photo_upload  [note: 'Upload ảnh lên photo wall']
  qr_scan       [note: 'Quét mã QR cá nhân']
  share_click   [note: 'Click nút chia sẻ']
  music_play    [note: 'Bật nhạc nền']
}

Enum audit_action {
  insert    [note: 'Tạo mới']
  update    [note: 'Cập nhật']
  delete    [note: 'Xóa (soft hoặc hard)']
  publish   [note: 'Xuất bản thiệp']
  archive   [note: 'Lưu trữ thiệp']
  login     [note: 'Đăng nhập']
  logout    [note: 'Đăng xuất']
}


