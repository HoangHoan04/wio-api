# ─── Server ───────────────────────────
NODE_ENV=development
PORT=4300

# ─── Database ─────────────────────────
DATABASE_URL='postgresql://postgres:root@localhost:5432/wio-dev'
TYPEORM_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=root
TYPEORM_DATABASE=wio-dev
TYPEORM_LOGGING=true

# ─── JWT ──────────────────────────────
JWT_SECRET=your_jwt_secret
JWT_EXPIRY=10h
JWT_REFRESH_SECRET=your_refresh_secret
JWT_REFRESH_EXPIRY=7d
KEY_SECRET=your_key_secret

# ─── Rate Limit ───────────────────────
LIMIT_RQ_PER_SECOND_PER_IP=10
LIMIT_RQ_PER_MINUTE_PER_IP=100

# ─── Zalo ─────────────────────────────
ZNS_SECRETKEY=your_zns_secret
ZNS_APP_ID=your_zns_app_id
ZALO_OAUTH_SECRET_KEY=your_zalo_oauth_secret

# ─── Google OAuth ─────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4300/api/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:2504

# ─── Facebook OAuth ───────────────────
FACEBOOK_APP_ID=your_fb_app_id
FACEBOOK_APP_SECRET=your_fb_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:4300/api/auth/facebook/callback
FACEBOOK_FRONTEND_REDIRECT_URL=http://localhost:2504

# ─── Email ────────────────────────────
EMAIL_VALIDATE_ACCOUNT=your_email@gmail.com
EMAIL_VALIDATE_PASSWORD=your_app_password
MILLISECOND_OTP_EFFECT=300000

# ─── Cloudinary ───────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
LINK_UPLOAD=lingoarena

# ─── Azure Translator ────────────────
AZURE_TRANSLATOR_KEY=your_azure_key
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
AZURE_TRANSLATOR_REGION=eastus

# ─── Catbox ──────────────────────────
CATBOX_USERHASH=

# ─── AI ───────────────────────────────
AI_PROVIDER_NAME=your_provider
AI_PROVIDER_API_KEY=your_api_key
AI_PROVIDER_BASE_URL=https://llm.example.com/v1

# ─── Telegram (CI/CD Notifications) ──
# Lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
# Chat ID nhóm/cá nhân nhận thông báo
TELEGRAM_CHAT_ID=your_chat_id
