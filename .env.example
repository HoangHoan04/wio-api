# Application
NODE_ENV=development
PORT=4300
TZ=Asia/Ho_Chi_Minh

# Docker Compose — PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=wio-dev
POSTGRES_PORT=5432

# Database (use DATABASE_URL or individual TYPEORM_* vars)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wio-dev
TYPEORM_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=
TYPEORM_DATABASE=wio-dev
TYPEORM_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
DB_PRIMARY_DATABASE=wio-dev

# JWT
JWT_SECRET=
JWT_EXPIRY=10h

# Rate limiting
LIMIT_RQ_PER_SECOND_PER_IP=10
LIMIT_RQ_PER_MINUTE_PER_IP=100

# Frontend URLs
CUSTOMER_URL=http://localhost:2504
GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:2504
FACEBOOK_FRONTEND_REDIRECT_URL=http://localhost:2504

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4300/api/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4300/api/auth/facebook/callback

# File upload (Cloudinary / Catbox)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CATBOX_USERHASH=

# Email (SMTP validation)
EMAIL_VALIDATE_ACCOUNT=
EMAIL_VALIDATE_PASSWORD=
ADMIN_EMAIL=

PEXELS_API_KEY=

# YouTube audio
YOUTUBE_AUDIO_PROVIDER=youtube-dl-exec
YOUTUBE_PYTHON_TMP_DIR=tmp/youtube
YOUTUBE_PYTHON_EXECUTABLE=python
YOUTUBE_PYTHON_SCRIPT=
YOUTUBE_PUBLIC_METADATA_API=
YOUTUBE_PUBLIC_DOWNLOAD_API=

# Monitoring / logging (optional)
PROJECT_NAME=WIO
SOURCE_CODE=WIO_API
ENVIRONMENT=development
PERF_THRESHOLD_DURATION=10000
PERF_THRESHOLD_MEMORY=500
PERF_THRESHOLD_CPU=500
PERF_THRESHOLD_STALL=500
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
