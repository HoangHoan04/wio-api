# Application
NODE_ENV=production
PORT=4300
TZ=Asia/Ho_Chi_Minh

# Docker Compose image
GHCR_OWNER=YOUR_GH_OWNER
TAG=latest

# PostgreSQL (container nội bộ, không publish ra internet)
POSTGRES_USER=wio
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=wio

# Database
DATABASE_URL=postgresql://wio:CHANGE_ME@postgres:5432/wio
TYPEORM_HOST=postgres
TYPEORM_PORT=5432
TYPEORM_USERNAME=wio
TYPEORM_PASSWORD=CHANGE_ME
TYPEORM_DATABASE=wio
TYPEORM_LOGGING=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
DB_PRIMARY_DATABASE=wio

# JWT
JWT_SECRET=CHANGE_ME_64_CHAR
JWT_EXPIRY=10h

# Rate limiting
LIMIT_RQ_PER_SECOND_PER_IP=10
LIMIT_RQ_PER_MINUTE_PER_IP=100

# Frontend URLs
CUSTOMER_URL=https://tiemcuoitanthoi.id.vn
ADMIN_URL=https://admin.tiemcuoitanthoi.id.vn
CORS_ORIGINS=https://tiemcuoitanthoi.id.vn,https://www.tiemcuoitanthoi.id.vn,https://admin.tiemcuoitanthoi.id.vn
TRUST_PROXY=true
ENABLE_SWAGGER=false
GOOGLE_FRONTEND_REDIRECT_URL=https://tiemcuoitanthoi.id.vn
FACEBOOK_FRONTEND_REDIRECT_URL=https://tiemcuoitanthoi.id.vn

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.tiemcuoitanthoi.id.vn/api/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://api.tiemcuoitanthoi.id.vn/api/auth/facebook/callback

# File upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CATBOX_USERHASH=

# Email
EMAIL_VALIDATE_ACCOUNT=
EMAIL_VALIDATE_PASSWORD=
ADMIN_EMAIL=

PEXELS_API_KEY=

# YouTube audio
YOUTUBE_AUDIO_PROVIDER=python-yt-dlp
YOUTUBE_PYTHON_TMP_DIR=tmp/youtube
YOUTUBE_PYTHON_EXECUTABLE=python
YOUTUBE_PYTHON_SCRIPT=
YOUTUBE_PUBLIC_METADATA_API=
YOUTUBE_PUBLIC_DOWNLOAD_API=

# Monitoring
PROJECT_NAME=WIO
SOURCE_CODE=WIO_API
ENVIRONMENT=production
PERF_THRESHOLD_DURATION=10000
PERF_THRESHOLD_MEMORY=500
PERF_THRESHOLD_CPU=500
PERF_THRESHOLD_STALL=500
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
